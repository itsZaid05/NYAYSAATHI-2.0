# Export backend environment variables with your service manager. Never put secrets in frontend files.
GEMINI_API_KEY=
# Set only after `python -m scripts.check_gemini` lists this model and terms/price/quota review.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Only synthetic demonstration narratives/documents may use the Gemini integration.
GEMINI_TERMS_REVIEWED=false
NYAYSAATHI_RUNTIME=runtime
SESSION_TTL_HOURS=24
RETENTION_DAYS=7
COOKIE_SECURE=false
# Set a strong private value to enable demo lawyer login. No default password.
DEMO_LAWYER_PASSWORD=
# Verifies actual account access on startup using synthetic probes. Decisions are visible in /api/health.
# If a configured model is unavailable, the previously validated audit fallback is probed and reported.
GEMINI_VERIFY_ON_START=true
