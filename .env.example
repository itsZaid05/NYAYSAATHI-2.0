PORT=8000
# Find Case Law: set BOTH only after TNA computational-analysis licence is granted in writing
CASELAW_LIVE_ENABLED=false
CASELAW_COMPUTATIONAL_LICENCE_CONFIRMED=false
# Gemini (OPTIONAL polish layer) — set on the HOST/deployment environment only.
# NEVER paste a key into chat, code, .env committed to git, or frontend code.
# Get a key at https://aistudio.google.com/apikey ; restrict it in Google Cloud.
GEMINI_API_KEY=
# Model is benchmark-selected (see docs); example current tiers: a Pro tier for
# explanation quality, a Flash tier for speed/cost. Pin after evaluation:
LLM_MODEL_EXPLANATION=
